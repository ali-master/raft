{
  "name": "@usex/raft",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "bun@1.4.3",
  "description": "Production-ready Raft consensus for Node.js. Build distributed systems with leader election, fault tolerance, and data replication.",
  "author": {
    "name": "Ali Torki",
    "email": "ali_4286@live.com",
    "url": "https://github.com/ali-master"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-master/raft.git",
    "directory": "packages/raft"
  },
  "keywords": [
    "raft",
    "distributed-systems",
    "leader-election",
    "fault-tolerance",
    "data-replication",
    "distributed",
    "consensus-algorithm",
    "distributed-consensus",
    "consensus",
    "nodejs",
    "javascript",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.3",
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "unbuild",
    "test": "CI=true TESTCONTAINERS_RYUK_DISABLED=true bun --bun vitest",
    "test:watch": "bun run test --watch",
    "test:ui": "bun run test:watch --ui --coverage.enabled=true",
    "test:bench": "bun run test bench",
    "test:coverage": "bun run test run --coverage",
    "test:debug": "vitest --inspect-brk --pool forks --maxWorkers 1",
    "test:debug:watch": "bun run test:debug --watch --no-isolate",
    "test:types": "tsc --noEmit",
    "inspect": "node-modules-inspector",
    "test:knip": "knip",
    "test:knip:fix": "knip --fix",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "eslint \"**/*.ts\"",
    "lint:fix": "eslint \"**/*.ts\" --fix",
    "prepublishOnly": "bun run lint && bun run test",
    "release": "bun run test && bumpp && bun publish",
    "prepack": "unbuild",
    "test:unit": "bun run test run --exclude \"**/integration/**\" --exclude \"**/integration.spec.ts\""
  },
  "peerDependencies": {
    "ioredis": "^6.0.0",
    "opossum": "^10.0.0",
    "prom-client": "^15.1.3"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "ioredis": "^6.0.0",
    "opossum": "^10.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@testcontainers/redis": "^12.2.1",
    "@types/opossum": "^8.1.9",
    "testcontainers": "^12.2.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
