{
  "name": "@usex/raft-playground",
  "version": "1.0.0",
  "description": "Executable Raft consensus scenarios, interactive CLI, and cluster visualizer",
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "dashboard": "bun src/dashboard/main.ts",
    "cli": "bun src/main.ts showcase",
    "cluster": "bun src/showcases/cluster-showcase.ts",
    "election": "bun src/showcases/leader-election.ts",
    "replication": "bun src/showcases/log-replication.ts",
    "membership": "bun src/showcases/membership-changes.ts",
    "snapshot": "bun src/showcases/snapshots.ts",
    "failures": "bun src/showcases/failure-scenarios.ts",
    "performance": "bun src/showcases/performance-tests.ts",
    "monitoring": "bun src/showcases/monitoring.ts",
    "weighted-voting": "bun src/showcases/weighted-voting.ts",
    "network-partition": "bun src/showcases/network-partition.ts",
    "leadership-transfer": "bun src/showcases/leadership-transfer.ts",
    "concurrent-writes": "bun src/showcases/concurrent-writes.ts",
    "recovery": "bun src/showcases/recovery-scenarios.ts",
    "stress-test": "bun src/showcases/stress-test.ts",
    "interactive": "bun src/interactive/cli.ts",
    "visualizer": "bun src/visualization/cluster-visualizer.ts",
    "all-examples": "bun run cluster && bun run election && bun run replication && bun run membership && bun run snapshot && bun run failures && bun run performance && bun run monitoring && bun run weighted-voting && bun run network-partition && bun run leadership-transfer && bun run concurrent-writes && bun run recovery && bun run stress-test",
    "dev": "bun --watch src/main.ts",
    "test:types": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,css,html}\"",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{ts,tsx}\" --fix",
    "test:dashboard": "bun test src/dashboard/dashboard.test.ts src/dashboard/commands.test.ts",
    "test:commands": "bun test src/dashboard/commands.integration.test.ts",
    "test": "bun run test:dashboard",
    "test:unit": "bun run test:dashboard"
  },
  "dependencies": {
    "@usex/raft": "workspace:*",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "bun-plugin-tailwind": "^0.1.2",
    "chalk": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "express": "^5.3.0",
    "inquirer": "^14.2.3",
    "interactive-commander": "^0.6.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.59.0",
    "ora": "^9.4.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.6",
    "@types/inquirer": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  }
}
