{
  "name": "@usex/kv-server-sdk",
  "version": "0.0.0",
  "description": "Open API SDK for kv-server, a distributed key-value store with Raft consensus.",
  "author": {
    "name": "Ali Torki",
    "email": "ali_4286@live.com",
    "url": "https://github.com/ali-master"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-master/raft.git",
    "directory": "packages/kv-server-sdk"
  },
  "main": "lib/client/index.js",
  "scripts": {
    "build": "if [ -f src/client/index.ts ]; then tsc; else echo \"Skipping build: run generate:client first\"; fi",
    "generate:client": "openapi-ts",
    "test": "vitest run --passWithNoTests",
    "release": "standard-version",
    "postrelease": "git push --follow-tags origin master && bun publish",
    "release:beta": "standard-version --prerelease beta",
    "postrelease:beta": "git push --follow-tags origin master && bun publish --tag beta"
  },
  "dependencies": {
    "load-script": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "standard-version": "^9.5.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@testing-library/dom": "^10.4.2",
    "happy-dom": "21.0.3",
    "msw": "^3.0.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "~5.0.5"
  },
  "engines": {
    "node": ">=22.22.3",
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3",
  "publishConfig": {
    "access": "public"
  },
  "types": "lib/client/index.d.ts"
}
