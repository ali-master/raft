{
  "name": "@usex/raft-nestjs-playground",
  "version": "1.0.0",
  "description": "Interactive playground for @usex/raft-nestjs",
  "private": true,
  "scripts": {
    "test": "CI=true TESTCONTAINERS_RYUK_DISABLED=true bun --bun vitest run",
    "start": "bun --bun nest start --watch --exec bun",
    "start:cluster": "concurrently \"bun run start:node1\" \"bun run start:node2\" \"bun run start:node3\"",
    "start:node1": "NODE_ID=node-1 HTTP_PORT=3001 bun run start",
    "start:node2": "NODE_ID=node-2 HTTP_PORT=3002 bun run start",
    "start:node3": "NODE_ID=node-3 HTTP_PORT=3003 bun run start",
    "start:monitoring": "concurrently \"bun run start:cluster\" \"bun run start:dashboard\"",
    "start:dashboard": "bun --bun nest start dashboard --watch --exec bun",
    "start:cli": "bun --bun nest start cli --exec bun",
    "test:load": "artillery run tests/load-test.yml",
    "test:chaos": "bun scripts/chaos-test.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "build": "tsc -p tsconfig.json",
    "start:dev": "bun --bun nest start --watch --exec bun",
    "start:prod": "bun dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/websockets": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/bull": "^12.0.0",
    "@usex/raft-nestjs": "workspace:*",
    "@usex/raft": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "bull": "^4.16.5",
    "ioredis": "^6.0.0",
    "socket.io": "^4.8.4",
    "prom-client": "^15.1.3",
    "class-validator": "^0.15.1",
    "class-transformer": "^0.5.1",
    "helmet": "^8.3.0",
    "compression": "^1.8.2",
    "chalk": "^6.0.1",
    "inquirer": "^14.2.3",
    "ora": "^9.4.1",
    "cli-table3": "^0.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@types/node": "^26.6.5",
    "@types/express": "^5.0.6",
    "@types/inquirer": "^9.0.10",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "artillery": "^2.0.34",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  }
}
