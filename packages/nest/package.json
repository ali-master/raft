{
  "name": "@usex/raft-nestjs",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "author": {
    "name": "Ali Torki",
    "email": "ali_4286@live.com",
    "url": "https://github.com/ali-master"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-master/raft.git",
    "directory": "packages/nest"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.3",
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "CI=true TESTCONTAINERS_RYUK_DISABLED=true bun --bun vitest",
    "test:watch": "bun run test --watch",
    "test:ui": "bun run test:watch --ui --coverage.enabled=true",
    "test:bench": "bun run test bench",
    "test:coverage": "bun run test run --coverage",
    "test:debug": "vitest --inspect-brk --pool forks --maxWorkers 1",
    "test:debug:watch": "bun run test:debug --watch --no-isolate",
    "inspect": "node-modules-inspector",
    "test:types": "tsc --noEmit",
    "test:knip": "knip",
    "test:knip:fix": "knip --fix",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "prepublish:next": "bun run build",
    "publish:next": "bun publish --access public --tag next",
    "prepublish:npm": "bun run build",
    "publish:npm": "bun publish --access public",
    "prerelease": "bun run build",
    "release": "release-it",
    "test:unit": "bun run test run --exclude \"**/integration/**\" --exclude \"**/integration.spec.ts\""
  },
  "dependencies": {
    "@usex/raft": "workspace:^",
    "eventemitter3": "^5.0.4"
  },
  "devDependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/testing": "12.1.3",
    "@swc/core": "^1.16.18",
    "@testcontainers/redis": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.5",
    "ioredis": "^6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "testcontainers": "^12.2.1",
    "unplugin-swc": "^2.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "changelog": {
    "labels": {
      "feature": "Features",
      "bug": "Bug fixes",
      "enhancement": "Enhancements",
      "docs": "Docs",
      "dependencies": "Dependencies",
      "type: code style": "Code style tweaks",
      "status: blocked": "Breaking changes",
      "breaking change": "Breaking changes"
    }
  },
  "packageManager": "bun@1.4.3"
}
