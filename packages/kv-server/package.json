{
  "name": "@usex/raft-kv-server",
  "version": "0.0.0",
  "description": "Enterprise-grade Raft KV Server with encryption support",
  "license": "MIT",
  "author": {
    "name": "Ali Torki",
    "email": "ali_4286@live.com",
    "url": "https://github.com/ali-master"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-master/raft.git",
    "directory": "packages/kv-server"
  },
  "keywords": [
    "raft",
    "kv-store",
    "distributed-systems",
    "enterprise",
    "encryption",
    "cqrs"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.3",
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "bun run build && bun dist/main.js",
    "start:dev": "bun --bun nest start --watch --exec bun",
    "start:debug": "bun --bun nest start --watch --exec \"bun --inspect\"",
    "start:prod": "bun dist/main.js",
    "test": "CI=true TESTCONTAINERS_RYUK_DISABLED=true bun --bun vitest",
    "test:watch": "bun run test --watch",
    "test:ui": "bun run test:watch --ui --coverage.enabled=true",
    "test:bench": "bun run test bench",
    "test:coverage": "bun run test run --coverage",
    "test:debug": "vitest --inspect-brk --pool forks --maxWorkers 1",
    "test:debug:watch": "bun run test:debug --watch --no-isolate",
    "inspect": "node-modules-inspector",
    "test:types": "tsc --noEmit",
    "test:knip": "knip",
    "test:knip:fix": "knip --fix",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "prepublish:next": "bun run build",
    "publish:next": "bun publish --access public --tag next",
    "prepublish:npm": "bun run build",
    "publish:npm": "bun publish --access public",
    "prerelease": "bun run build",
    "release": "release-it",
    "test:unit": "bun run test run --exclude \"**/integration/**\" --exclude \"**/integration.spec.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/platform-fastify": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@usex/raft": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "crypto-js": "^4.2.0",
    "eventemitter3": "^5.0.4",
    "fastify": "^5.12.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@fastify/compress": "^9.2.2",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@swc/core": "^1.16.18",
    "@testcontainers/redis": "^12.2.1",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.1",
    "ts-loader": "^9.6.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "changelog": {
    "labels": {
      "feature": "Features",
      "bug": "Bug fixes",
      "enhancement": "Enhancements",
      "docs": "Docs",
      "dependencies": "Dependencies",
      "type: code style": "Code style tweaks",
      "status: blocked": "Breaking changes",
      "breaking change": "Breaking changes"
    }
  },
  "packageManager": "bun@1.4.3"
}
